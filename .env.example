# Zmienne Cloudflare Pages (Settings → Environment variables).
# SUPABASE_SERVICE_ROLE_KEY ustaw jako Secret (zaszyfrowany). NIGDY nie wklejaj go do gita ani do config.js.
# Wartości poniżej są puste celowo.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Kanoniczny adres stron, np. https://panel.nowoczesnyhandelpolski.pl
PUBLIC_ORIGIN=
# Opcjonalny szablon linku płatności. Podstawiane: {number} {total} {email} {slug}
# Gdy puste, zamówienie zapisuje się ze statusem płatności „oczekuje”, a pay_url jest puste.
PAY_URL_TEMPLATE=

# Allegro OAuth (aplikacja w Allegro dla sprzedawców). Sekret, nie commitować prawdziwych wartości.
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
# Dokładny adres zwrotki zarejestrowany w aplikacji Allegro, np.
# https://panel.nowoczesnyhandelpolski.pl/api/allegro/callback
ALLEGRO_REDIRECT_URL=

# Tekst i zdjęcia AI. Model tekstu domyślnie gpt-5-mini, zdjęcia gpt-image-1.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=
