# Zmienne Cloudflare Pages (Settings → Environment variables).
# SUPABASE_SERVICE_ROLE_KEY ustaw jako Secret (zaszyfrowany). NIGDY nie wklejaj go do gita ani do config.js.
# Wartości poniżej są puste celowo.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Opcjonalnie. Pobranie ZIP wtyczki działa bez tego: używa klucza publishable z config.js.
SUPABASE_ANON_KEY=
# Kanoniczny adres stron, np. https://panel.nowoczesnyhandelpolski.pl
PUBLIC_ORIGIN=
# Opcjonalny szablon linku płatności. Podstawiane: {number} {total} {email} {slug}
# Gdy puste, zamówienie zapisuje się ze statusem płatności „oczekuje”, a pay_url jest puste.
PAY_URL_TEMPLATE=

# Allegro OAuth (aplikacja w Allegro dla sprzedawców). Sekret, nie commitować prawdziwych wartości.
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
# Dokładny adres zwrotki zarejestrowany w aplikacji Allegro, np.
# https://panel.nowoczesnyhandelpolski.pl/api/allegro/callback
ALLEGRO_REDIRECT_URL=

# Tekst i zdjęcia AI. Model tekstu domyślnie gpt-5-mini, zdjęcia gpt-image-1.
# OPENAI_API_KEY jest opcjonalny, gdy klucz jest zapisany w Ustawieniach.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=
# Secret, 32 bajty. Szyfruje klucz z Ustawień. Wygeneruj: openssl rand -base64 32
NHP_ENC_KEY=

# Shopify Admin API. Wartości zostają w sekretach Cloudflare. Instrukcja: docs/shopify-ksef.md
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
# Opcjonalnie: id lokalizacji magazynu Shopify (liczba). Bez tego panel bierze główną lokalizację sklepu.
SHOPIFY_LOCATION_ID=
# Opcjonalny sekret nagłówka X-NHP-Sync dla webhooka bazy (kolejka → /api/shopify/flush).
NHP_SYNC_SECRET=

# KSeF 2.0. Domyślnie środowisko testowe. Nie wklejaj prawdziwego tokenu do gita.
KSEF_TOKEN=
KSEF_NIP=
KSEF_ENV=test
KSEF_SELLER_NAME=
KSEF_SELLER_ADDRESS1=
KSEF_SELLER_ADDRESS2=
# 23, 8, 5 albo zw
KSEF_VAT_RATE=23

# Base (BaseLinker) — token API z Base → Moje konto → API. Tylko jako Secret w Cloudflare. Instrukcja: docs/base.md
BASE_API_TOKEN=
